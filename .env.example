# Frontend Environment Variables

VITE_API_URL=http://localhost:5000/api

# Store Location Configuration
# Get coordinates from Google Maps:
# 1. Go to: https://www.google.com/maps
# 2. Search your store address
# 3. Right-click on location → "What's here?"
# 4. Copy the coordinates shown
VITE_STORE_LATITUDE=26.38224
VITE_STORE_LONGITUDE=84.58723
VITE_STORE_NAME=Alok General Store
VITE_STORE_ADDRESS=Main Road, Barauli, Gopalganj, 841405, Bihar

# NO API KEY REQUIRED! 
# Using FREE OpenStreetMap (Leaflet) - No payment verification needed!
